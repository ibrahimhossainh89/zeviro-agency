# ---------- Server ----------
PORT=5000
NODE_ENV=development
# Local:      CLIENT_URL=http://localhost:5173
# Production: CLIENT_URL=https://zeviro.agency,https://www.zeviro.agency,https://team.zeviro.agency,https://admin.zeviro.agency
CLIENT_URL=http://localhost:5173
# Your main website address. team.<domain> and admin.<domain> are derived from it.
SITE_URL=https://zeviro.agency

# ---------- Database ----------
MONGO_URI=mongodb://127.0.0.1:27017/zeviro

# ---------- Auth ----------
# Use a long random string in production (e.g. `openssl rand -hex 48`)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# ---------- Email (SMTP) ----------
# If SMTP_HOST is empty, emails are printed to the console instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Zeviro Agency <hello@zeviro.agency>"
ADMIN_NOTIFY_EMAIL=hello@zeviro.agency

# ---------- AI Chatbot (optional) ----------
# If empty, the chatbot answers from the knowledge base (FAQs + services) with keyword matching.
# If set, answers are generated by Claude using ONLY the approved knowledge base as context.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---------- Uploads ----------
MAX_UPLOAD_MB=15

# ---------- Seed ----------
# The super admin account created by `npm run seed` (log in at admin.<your-domain>/login)
SEED_ADMIN_EMAIL=admin@zeviro.agency
SEED_ADMIN_NAME=Md Ibrahim Hossain
SEED_ADMIN_PASSWORD=Admin@12345
API_RATE_LIMIT=1200

# ---------- SMS (login codes by phone — optional) ----------
# Twilio: https://www.twilio.com  (or leave empty and set SMS_WEBHOOK_URL for a Bangladeshi SMS gateway)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Generic HTTP gateway with {to} and {message} placeholders, e.g. https://api.example.com/send?key=XXX&to={to}&msg={message}
SMS_WEBHOOK_URL=
